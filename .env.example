# FloodIQ Configuration
# Copy this file to .env and fill in your values

# Groq API Key (only hosted LLM provider for FloodIQ triage; get one at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq model identifier supporting Structured Outputs (json_schema)
GROQ_MODEL=openai/gpt-oss-20b

# Rate-limit cooldown & retry bounds
# GROQ_COOLDOWN_SECONDS=60
# GROQ_MAX_RETRIES=2

# Database path (default: floodiq.db in project root)
# DATABASE_PATH=floodiq.db

# Open-Meteo timeout in seconds (default: 10)
# WEATHER_API_TIMEOUT=10

# Enable offline/demo mode (default: false — will auto-fallback if APIs fail)
# OFFLINE_MODE=false
