# FloodIQ Configuration
# Copy this file to .env and fill in your values

# Google Gemini API Key (get one free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Database path (default: floodiq.db in project root)
# DATABASE_PATH=floodiq.db

# Open-Meteo timeout in seconds (default: 10)
# WEATHER_API_TIMEOUT=10

# Enable offline/demo mode (default: false — will auto-fallback if APIs fail)
# OFFLINE_MODE=false
